# Copy to .env for docker compose. No real secrets in this file.

# audio.cpp base URL as seen from inside the container. Not 127.0.0.1 (that is the container
# itself): use host.docker.internal for an audio.cpp on the Docker host (it must listen on
# 0.0.0.0, not 127.0.0.1), or the host/IP of the machine running it.
OMNIVOICE_GATEWAY_UPSTREAM_URL=http://host.docker.internal:8080

# Set to require "Authorization: Bearer <key>" on every route except /health and /ready.
# Empty disables auth.
OMNIVOICE_GATEWAY_API_KEY=

# Host port published for the gateway (the container listens on 8000, from configs/gateway.toml).
GATEWAY_PORT=8000
