# Copy to .env for docker compose. No real secrets in this file.

# Deployment shape; docker compose reads COMPOSE_FILE from .env (":" separated):
#   gateway only, upstream elsewhere:    compose.yaml
#   zerotts_server only (a CPU node):    compose.zerotts.yaml
#   gateway + zerotts_server, one host:  compose.yaml:compose.zerotts.yaml:compose.zerotts-stack.yaml
COMPOSE_FILE=compose.yaml

# --- gateway ---

# Upstream (zerotts_server) base URL as seen from inside the container. Ignored with
# compose.zerotts-stack.yaml (http://zerotts:8080).
# Not 127.0.0.1 (that is the container itself): use host.docker.internal for an upstream on the
# Docker host (it must listen on 0.0.0.0, not 127.0.0.1), or the host/IP of the machine running it.
ZEROTTS_GATEWAY_UPSTREAM_URL=http://host.docker.internal:8080

# Set to require "Authorization: Bearer <key>" on every route except /health and /ready.
# Empty disables auth.
ZEROTTS_GATEWAY_API_KEY=

# Host port published for the gateway (the container listens on 8000, from configs/gateway.toml).
# Use 127.0.0.1:8000 for local-only access; bare 8000 publishes on all interfaces.
GATEWAY_PORT=8000

# --- zerotts_server (compose.zerotts.yaml) ---

# Host address/port zerotts_server is published on. It has no auth: keep 127.0.0.1 unless a
# gateway on another host must reach it, and then restrict it by firewall.
ZEROTTS_SERVER_BIND=127.0.0.1
ZEROTTS_SERVER_PORT=8080
# Image name; set a registry name to push/pull between hosts.
ZEROTTS_SERVER_IMAGE=zerotts-server:local
