# Copy to .env for docker compose. No real secrets in this file.

# Deployment shape; docker compose reads COMPOSE_FILE from .env (":" separated):
#   gateway only, audio.cpp elsewhere:   compose.yaml
#   audio.cpp only (e.g. a GPU host):    compose.audiocpp.yaml
#   gateway + audio.cpp on one GPU host: compose.yaml:compose.audiocpp.yaml:compose.stack.yaml
#   gateway + audio.cpp on CPU only:     compose.yaml:compose.audiocpp.yaml:compose.stack.yaml:compose.cpu.yaml
#   audio.cpp on CPU only:              compose.audiocpp.yaml:compose.cpu.yaml
COMPOSE_FILE=compose.yaml

# --- gateway ---

# audio.cpp base URL as seen from inside the container. Ignored with compose.stack.yaml (it uses
# http://audiocpp:8080). Not 127.0.0.1 (that is the container itself): use host.docker.internal
# for an audio.cpp on the Docker host (it must listen on 0.0.0.0, not 127.0.0.1), or the host/IP
# of the machine running it.
ZEROTTS_GATEWAY_UPSTREAM_URL=http://host.docker.internal:8080

# Set to require "Authorization: Bearer <key>" on every route except /health and /ready.
# Empty disables auth.
ZEROTTS_GATEWAY_API_KEY=

# Host port published for the gateway (the container listens on 8000, from configs/gateway.toml).
# Use 127.0.0.1:8000 for local-only access; bare 8000 publishes on all interfaces.
GATEWAY_PORT=8000

# --- audio.cpp (compose.audiocpp.yaml) ---

# Host GPU index given to the container (seen inside as device 0).
AUDIOCPP_GPU=0
# Host address/port audio.cpp is published on. audio.cpp has no auth: keep 127.0.0.1 unless a
# gateway on another host must reach it, and then restrict it by firewall.
AUDIOCPP_BIND=127.0.0.1
AUDIOCPP_PORT=8080
# CUDA arch(s) compiled into the image: 80 = A100; e.g. "80;86;89;90" for mixed GPUs.
AUDIOCPP_CUDA_ARCH=80
# CPU overlay uses Ubuntu (no CUDA/NVIDIA runtime); separate image tag avoids GPU image collisions.
AUDIOCPP_CPU_IMAGE=omnivoice-audiocpp:cpu
# CPU overlay: limits upstream compilation memory use (GPU Dockerfile also accepts BUILD_JOBS).
AUDIOCPP_BUILD_JOBS=4
# audio.cpp WebUI on AUDIOCPP_PORT, talking to audio.cpp directly (no gateway text pipeline):
#   off     API only
#   on      WebUI for the models in configs/server.json
#   manage  also downloads/deletes packages, loads/unloads models, browses server directories;
#           keep AUDIOCPP_BIND=127.0.0.1 and open it with: ssh -L 8080:127.0.0.1:8080 <host>
AUDIOCPP_UI=off
# Hugging Face token, only for gated/private repos downloaded from the WebUI (manage).
HF_TOKEN=
